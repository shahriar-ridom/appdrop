pkgname=appdrop
pkgver=0.1.0
pkgrel=1
pkgdesc="A polished GTK4 AppImage installer and manager"
arch=('x86_64')
url="https://github.com/shahriar-ridom/appdrop"
license=('unknown')
depends=(
  'gtk4'
  'libadwaita'
  'squashfs-tools'
)
makedepends=(
  'cargo'
  'rust'
  'git'
)
source=(
  "appdrop::git+https://github.com/shahriar-ridom/appdrop.git#branch=main"
)
sha256sums=('SKIP')

prepare() {
  cd "$srcdir/appdrop"
  cargo fetch --locked
}

build() {
  cd "$srcdir/appdrop"
  cargo build --release --frozen
}

package() {
  cd "$srcdir/appdrop"

  install -Dm755 target/release/appdrop \
    "$pkgdir/usr/bin/appdrop"

  install -Dm644 /dev/stdin \
    "$pkgdir/usr/share/applications/appdrop.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=AppDrop
Comment=Install and manage AppImage applications
Exec=appdrop %f
Icon=application-x-executable
Terminal=false
Categories=Utility;
MimeType=application/vnd.appimage;
StartupNotify=true
EOF
}
